{
  "name": "samuel-narrative",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm schema:validate && next build",
    "start": "next start",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "schema:validate": "npx tsx scripts/validate-posts.ts",
    "images:cleanup": "node --import tsx scripts/cleanup-orphan-images.ts",
    "images:cleanup:dry": "node --import tsx scripts/cleanup-orphan-images.ts --dry-run",
    "test": "node --import tsx --test scripts/image-cleanup.test.ts src/lib/content/local-reader.test.ts src/app/site-url.test.ts src/lib/content/markdown.test.ts src/lib/schemas/post.test.ts src/lib/content/snapshot-provider.test.ts src/lib/content/github-store.test.ts src/lib/auth/auth.test.ts",
    "test:images": "node --import tsx --test scripts/image-cleanup.test.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@tailwindcss/typography": "^0.5.19",
    "@types/nprogress": "^0.2.3",
    "@uiw/react-markdown-preview": "^5.1.5",
    "@uiw/react-md-editor": "^4.0.11",
    "@vercel/blob": "^2.0.0",
    "@vercel/og": "^0.8.6",
    "browser-image-compression": "^2.0.2",
    "gray-matter": "^4.0.3",
    "next": "^16.4.6",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "nprogress": "^0.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "slugify": "^1.6.6",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "25.0.3",
    "@types/react": "19.2.7",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "7.0.2"
  }
}
